# Shared environment template for alpha-assay.
# Copy to .env and fill in the values (`.env` is gitignored).

# ==== Pipeline (app/) ====

GITHUB_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
DEFAULT_WORKSPACE=./workspace
DEFAULT_BACKEND=conda
DEFAULT_TIMEOUT_MINUTES=30
DEFAULT_MAX_REPAIR_ATTEMPTS=5
DEFAULT_PREFER_CPU=true

# ==== Contract-guided generation (contractgen/) ====

# LLM used by plan/generate/repair stages.
PAPERBENCH_REPRO_NODE_MODEL=gemini-3-flash-preview
PAPERBENCH_REPRO_NODE_API_KEY=
PAPERBENCH_REPRO_NODE_BASE_URL=

# LLM used by structured JSON stages. These can match the node model.
PAPERBENCH_REPRO_STRUCTURED_STAGE_MODEL=gemini-3-flash-preview
PAPERBENCH_REPRO_STRUCTURED_STAGE_API_KEY=
PAPERBENCH_REPRO_STRUCTURED_STAGE_BASE_URL=

# Optional GitHub token for reference-evidence source search and clone.
PAPERBENCH_REPRO_GITHUB_TOKEN=

# Optional runtime controls.
PAPERBENCH_REPRO_CODEGEN_MODE=llm_agent
PAPERBENCH_REPRO_REPAIR_CODEGEN_MODE=llm_agent
PAPERBENCH_REPRO_NODE_TIMEOUT=900
PAPERBENCH_REPRO_STRUCTURED_STAGE_TIMEOUT=900

# Ablation switch: disable the implementation-requirement channel.
PAPERBENCH_REPRO_DISABLE_IMPLEMENTATION_REQUIREMENTS=0
